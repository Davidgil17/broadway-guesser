DB_PASSWORD=changeme

# Where feedback notifications come from and go to. The Gmail app password is
# written as its four space-separated groups, unquoted. Leave SMTP_USER empty to
# turn sending off: feedback is still saved, only the email is skipped.
SMTP_USER=someone@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FEEDBACK_TO=someone@gmail.com
